<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bucks – คำนวณค่างวดและดอกเบี้ย</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f2f4f1;
  --panel: #e6ebe6;
  --ink: #15292b;
  --muted: #53686a;
  --line: #c4cec8;
  --prin: #0f5c4d;
  --int: #c58a1b;
  --warn: #b3402a;
  --btn-ink: #ffffff;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #101a1b; --panel: #172628; --ink: #e8efec; --muted: #94a9a8;
    --line: #2c4143; --prin: #3fb59b; --int: #e0a93f; --warn: #f08a72;
    --btn-ink: #0b1415; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #101a1b; --panel: #172628; --ink: #e8efec; --muted: #94a9a8;
  --line: #2c4143; --prin: #3fb59b; --int: #e0a93f; --warn: #f08a72;
  --btn-ink: #0b1415; color-scheme: dark;
}
html { scroll-padding-top: env(safe-area-inset-top, 0px); }
*, *::before, *::after { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--ink);
  font-family: "IBM Plex Sans Thai", "Noto Sans Thai", "Sarabun", system-ui, sans-serif;
  font-size: 16px; line-height: 1.6;
}
.wrap { max-width: 1040px; margin: 0 auto; padding: 28px 18px 64px; }
header h1 { margin: 0; font-size: 1.9rem; font-weight: 700; letter-spacing: -0.01em; }
header p { margin: 4px 0 0; color: var(--muted); }
h2 { font-size: 1.15rem; margin: 0 0 12px; font-weight: 700; }
section { margin-top: 40px; }
.top { display: grid; gap: 28px; margin-top: 24px; }
@media (min-width: 820px) { .top { grid-template-columns: 340px 1fr; align-items: start; } }

form.panel { background: var(--panel); padding: 20px; border-radius: 14px; }
label, legend { display: block; font-weight: 500; font-size: .93rem; margin-bottom: 4px; }
fieldset { border: 0; padding: 0; margin: 0 0 14px; }
.field { margin-bottom: 14px; }
input[type=number], input[type=text] {
  width: 100%; font: inherit; color: var(--ink); background: var(--bg);
  border: 1.5px solid var(--line); border-radius: 8px; padding: 9px 11px;
}
input:focus-visible, button:focus-visible, .seg input:focus-visible + span {
  outline: 3px solid var(--int); outline-offset: 2px;
}
.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.seg { display: grid; grid-template-columns: 1fr 1fr; border: 1.5px solid var(--line); border-radius: 8px; overflow: hidden; }
.seg label { margin: 0; cursor: pointer; }
.seg input { position: absolute; opacity: 0; pointer-events: none; }
.seg span { display: block; text-align: center; padding: 9px 6px; font-size: .92rem; background: var(--bg); }
.seg input:checked + span { background: var(--prin); color: var(--btn-ink); font-weight: 700; }
.hint { color: var(--muted); font-size: .85rem; margin: 6px 0 0; }

.result .big { font-size: clamp(2.4rem, 8vw, 3.6rem); font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
.result .big small { font-size: 1rem; font-weight: 400; color: var(--muted); margin-left: 6px; }
.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; margin: 20px 0; padding-top: 16px; border-top: 1.5px solid var(--line); }
.facts dt { color: var(--muted); font-size: .85rem; }
.facts dd { margin: 0; font-weight: 700; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
.msg { color: var(--warn); font-weight: 500; }
.warn { color: var(--warn); }

.legend { display: flex; gap: 18px; font-size: .88rem; color: var(--muted); margin-bottom: 8px; }
.legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
.chart { width: 100%; height: auto; display: block; }
.chart .p { fill: var(--prin); } .chart .i { fill: var(--int); }
.axis { display: flex; justify-content: space-between; color: var(--muted); font-size: .82rem; }

button {
  font: inherit; font-weight: 500; cursor: pointer; border: 0; border-radius: 8px;
  padding: 9px 16px; background: var(--prin); color: var(--btn-ink);
}
button.ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--line); }
button.link { background: none; color: var(--warn); padding: 2px 6px; }

.scroll { overflow-x: auto; max-width: 100%; border: 1.5px solid var(--line); border-radius: 10px; }
.scroll.tall { max-height: 420px; overflow-y: auto; }
table { border-collapse: collapse; width: 100%; min-width: 560px; font-variant-numeric: tabular-nums; }
th, td { padding: 8px 12px; text-align: right; border-bottom: 1px solid var(--line); white-space: nowrap; }
th:first-child, td:first-child { text-align: left; }
thead th { position: sticky; top: 0; background: var(--panel); font-weight: 700; font-size: .9rem; }
tr.best td { color: var(--prin); font-weight: 700; }
.extra-out { margin-top: 12px; font-size: 1.05rem; }
.extra-out strong { color: var(--prin); }
.save-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
.save-row input { flex: 1 1 180px; width: auto; }
.empty { color: var(--muted); }
@media (prefers-reduced-motion: no-preference) { button { transition: opacity .15s; } button:hover { opacity: .88; } }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Bucks</h1>
    <p>ใส่ยอดกู้ ดอกเบี้ย และจำนวนงวด แล้วดูว่าจ่ายดอกเบี้ยไปเท่าไร</p>
  </header>

  <div class="top">
    <form class="panel" id="f" onsubmit="return false" novalidate>
      <fieldset>
        <legend>ประเภทดอกเบี้ย</legend>
        <div class="seg">
          <label><input type="radio" name="type" value="2" checked><span>ลดต้นลดดอก</span></label>
          <label><input type="radio" name="type" value="1"><span>Flat</span></label>
        </div>
      </fieldset>
      <div class="field">
        <label for="P">เงินต้น (บาท)</label>
        <input id="P" type="number" inputmode="decimal" min="1" step="any" value="100000">
      </div>
      <div class="row2">
        <div class="field">
          <label for="R">ดอกเบี้ยต่อปี (%)</label>
          <input id="R" type="number" inputmode="decimal" min="0" step="any" value="12">
        </div>
        <div class="field">
          <label for="N">จำนวนงวด (เดือน)</label>
          <input id="N" type="number" inputmode="numeric" min="1" max="360" step="1" value="24">
        </div>
      </div>
      <p class="hint">Flat คิดดอกจากเงินต้นเต็มจำนวนตลอดสัญญา ส่วนลดต้นลดดอกคิดจากยอดคงเหลือ</p>
    </form>

    <div class="result" aria-live="polite">
      <div id="out"></div>
    </div>
  </div>

  <section id="chartSec">
    <h2>ค่างวดแต่ละเดือนแบ่งเป็นอะไรบ้าง</h2>
    <div class="legend"><span><i style="background:var(--prin)"></i>เงินต้น</span><span><i style="background:var(--int)"></i>ดอกเบี้ย</span></div>
    <div id="chart"></div>
    <div class="axis"><span>งวดที่ 1</span><span id="lastLabel"></span></div>
  </section>

  <section>
    <h2>จ่ายเพิ่มต่อเดือน</h2>
    <div class="field" style="max-width:340px">
      <label for="X">จ่ายเพิ่มเดือนละ (บาท)</label>
      <input id="X" type="number" inputmode="decimal" min="0" step="any" value="1000">
    </div>
    <div class="extra-out" id="extra"></div>
  </section>

  <section>
    <h2>ตารางผ่อนชำระ</h2>
    <div class="scroll tall">
      <table>
        <thead><tr><th>งวด</th><th>ค่างวด</th><th>ดอกเบี้ย</th><th>เงินต้น</th><th>คงเหลือ</th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>เปรียบเทียบสัญญา</h2>
    <p class="hint" style="margin-top:0">ปรับตัวเลขด้านบน แล้วกดเก็บไว้เพื่อเทียบหลายเงื่อนไขพร้อมกัน</p>
    <div class="save-row">
      <input id="nm" type="text" placeholder="ชื่อสัญญา เช่น ธนาคาร A" aria-label="ชื่อสัญญา">
      <button id="saveBtn" type="button">เก็บไว้เปรียบเทียบ</button>
    </div>
    <div id="cmp" style="margin-top:16px"></div>
  </section>
</div>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var fmt = function (x) { return x.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
  var esc = function (s) { return String(s).replace(/[&<>"']/g, function (c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); };

  var current = null;   // ผลคำนวณล่าสุด
  var saved = [];

  function getType() { return document.querySelector('input[name=type]:checked').value === '1' ? 1 : 2; }

  // ---------- คำนวณตาราง ----------
  function calc(P, rate, n, type) {
    var rows = [], pay, bal = P, totalInt = 0, i;
    switch (type) {            // switch case: เลือกสูตรตามประเภทดอกเบี้ย
    case 1: {
      var ti = P * (rate / 100) * (n / 12);
      pay = (P + ti) / n;
      for (i = 1; i <= n; i++) {
        bal -= P / n;
        rows.push({ i: i, pay: pay, int: ti / n, prin: P / n, bal: bal < 0.005 ? 0 : bal });
      }
      totalInt = ti;
      break;
    }
    default: {
      var r = rate / 12 / 100;
      pay = r === 0 ? P / n : P * r / (1 - Math.pow(1 + r, -n));
      for (i = 1; i <= n; i++) {
        var it = bal * r, pr = pay - it;
        bal -= pr; totalInt += it;
        rows.push({ i: i, pay: pay, int: it, prin: pr, bal: bal < 0.005 ? 0 : bal });
      }
      break;
    }
    }
    return { P: P, rate: rate, n: n, type: type, pay: pay, rows: rows, totalInt: totalInt };
  }

  // ดอกเบี้ยที่แท้จริงต่อปี (หา r ที่ทำให้ annuity เท่ากับค่างวด)
  function effectiveRate(P, pay, n) {
    var lo = 0, hi = 1, mid, f;
    for (var k = 0; k < 70; k++) {
      mid = (lo + hi) / 2;
      f = P * mid / (1 - Math.pow(1 + mid, -n));
      if (f < pay) lo = mid; else hi = mid;
    }
    return mid * 12 * 100;
  }

  function simulateExtra(c, extra) {
    var r = c.rate / 12 / 100, bal = c.P, tot = 0, k = 0;
    while (bal > 0.005 && k < 1200) {
      var it = bal * r, pay = Math.min(c.pay + extra, bal + it);
      bal -= (pay - it); tot += it; k++;
    }
    return { months: k, totalInt: tot };
  }

  // ---------- วาดผล ----------
  function render() {
    var P = parseFloat($('P').value), R = parseFloat($('R').value), N = parseInt($('N').value, 10), type = getType();
    var out = $('out');
    if (!(P > 0) || !(R >= 0) || !(N >= 1) || N > 360) {
      current = null;
      out.innerHTML = '<p class="msg">กรอกเงินต้นมากกว่า 0 ดอกเบี้ยไม่ติดลบ และจำนวนงวด 1–360 เดือน</p>';
      $('chart').innerHTML = ''; $('rows').innerHTML = ''; $('extra').innerHTML = ''; $('lastLabel').textContent = '';
      return;
    }
    var c = calc(P, R, N, type); current = c;
    var total = P + c.totalInt;
    var html = '<div>ค่างวดต่อเดือน</div><div class="big">' + fmt(c.pay) + '<small>บาท</small></div>' +
      '<dl class="facts">' +
      '<div><dt>ดอกเบี้ยรวม</dt><dd>' + fmt(c.totalInt) + '</dd></div>' +
      '<div><dt>จ่ายทั้งหมด</dt><dd>' + fmt(total) + '</dd></div>' +
      '<div><dt>ดอกเบี้ยคิดเป็น</dt><dd>' + (c.totalInt / P * 100).toFixed(1) + '% ของเงินต้น</dd></div>';
    if (type === 1) {
      html += '<div><dt>ดอกเบี้ยที่แท้จริงต่อปี</dt><dd>ประมาณ ' + effectiveRate(P, c.pay, N).toFixed(2) + '%</dd></div>';
    }
    html += '</dl>';
    if (c.pay > P / 2) html += '<p class="warn">ค่างวดสูงมากเมื่อเทียบกับเงินต้น ลองเพิ่มจำนวนงวด</p>';
    if (type === 1) html += '<p class="hint">แบบ Flat ดอกเบี้ยที่แท้จริงสูงกว่าอัตราที่ประกาศ เพราะยังคิดดอกจากเงินต้นเต็มทั้งที่ผ่อนไปแล้ว</p>';
    out.innerHTML = html;

    drawChart(c);
    drawRows(c);
    drawExtra(c);
  }

  function drawChart(c) {
    var W = 720, H = 200, n = c.rows.length, bw = W / n, gap = n > 60 ? 0 : Math.min(2, bw * 0.15), s = '';
    for (var k = 0; k < n; k++) {
      var r = c.rows[k], total = r.int + r.prin;
      var hp = r.prin / c.pay * H, hi = r.int / c.pay * H;
      var x = (k * bw + gap / 2).toFixed(2), w = Math.max(bw - gap, 0.3).toFixed(2);
      s += '<rect class="p" x="' + x + '" y="' + (H - hp).toFixed(2) + '" width="' + w + '" height="' + hp.toFixed(2) + '"/>';
      s += '<rect class="i" x="' + x + '" y="' + (H - hp - hi).toFixed(2) + '" width="' + w + '" height="' + hi.toFixed(2) + '"/>';
    }
    $('chart').innerHTML = '<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="กราฟแท่งแสดงสัดส่วนเงินต้นและดอกเบี้ยในแต่ละงวด">' + s + '</svg>';
    $('lastLabel').textContent = 'งวดที่ ' + n;
  }

  function drawRows(c) {
    var h = '';
    for (var k = 0; k < c.rows.length; k++) {
      var r = c.rows[k];
      h += '<tr><td>' + r.i + '</td><td>' + fmt(r.pay) + '</td><td>' + fmt(r.int) + '</td><td>' + fmt(r.prin) + '</td><td>' + fmt(r.bal) + '</td></tr>';
    }
    $('rows').innerHTML = h;
  }

  function drawExtra(c) {
    var el = $('extra'), x = parseFloat($('X').value);
    if (c.type !== 2) { el.innerHTML = '<span class="empty">ใช้ได้กับแบบลดต้นลดดอกเท่านั้น เลือกประเภทนี้ด้านบนเพื่อดูผล</span>'; return; }
    if (!(x > 0)) { el.innerHTML = '<span class="empty">ใส่จำนวนเงินที่จะจ่ายเพิ่มเพื่อดูว่าปิดหนี้เร็วขึ้นแค่ไหน</span>'; return; }
    var sim = simulateExtra(c, x), saveM = c.n - sim.months, saveI = c.totalInt - sim.totalInt;
    el.innerHTML = 'ปิดหนี้ใน <strong>' + sim.months + ' งวด</strong> เร็วขึ้น ' + saveM + ' งวด ประหยัดดอกเบี้ย <strong>' + fmt(saveI) + ' บาท</strong>';
  }

  // ---------- เปรียบเทียบ ----------
  function persist() { try { localStorage.setItem('bucks.saved', JSON.stringify(saved)); } catch (e) {} }
  function load() {
    try { var v = localStorage.getItem('bucks.saved'); if (v) saved = JSON.parse(v) || []; } catch (e) { saved = []; }
  }

  // switch case: แปลงรหัสประเภทเป็นชื่อที่แสดง
  function typeName(t) {
    switch (t) {
      case 1: return 'Flat';
      case 2: return 'ลดต้นลดดอก';
      default: return 'ไม่ทราบ';
    }
  }

  function drawCompare() {
    var box = $('cmp');
    if (!saved.length) { box.innerHTML = '<p class="empty">ยังไม่มีสัญญาที่เก็บไว้</p>'; return; }
    var best = 0, k;
    for (k = 1; k < saved.length; k++) if (saved[k].totalInt < saved[best].totalInt) best = k;
    var h = '<div class="scroll"><table style="min-width:640px"><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>เงินต้น</th><th>ดอกเบี้ย/ปี</th><th>งวด</th><th>ค่างวด</th><th>ดอกเบี้ยรวม</th><th></th></tr></thead><tbody>';
    for (k = 0; k < saved.length; k++) {
      var s = saved[k];
      h += '<tr' + (k === best && saved.length > 1 ? ' class="best"' : '') + '><td>' + esc(s.name) + '</td><td>' + typeName(s.type) + '</td><td>' + fmt(s.P) + '</td><td>' + s.rate + '%</td><td>' + s.n + '</td><td>' + fmt(s.pay) + '</td><td>' + fmt(s.totalInt) + '</td><td><button class="link" type="button" data-del="' + k + '">ลบ</button></td></tr>';
    }
    h += '</tbody></table></div>';
    if (saved.length > 1) h += '<p class="hint">แถวสีเขียวคือสัญญาที่ดอกเบี้ยรวมต่ำสุด: ' + esc(saved[best].name) + '</p>';
    box.innerHTML = h;
  }

  $('saveBtn').addEventListener('click', function () {
    if (!current) return;
    if (saved.length >= 10) { $('cmp').insertAdjacentHTML('afterbegin', '<p class="msg">เก็บได้สูงสุด 10 สัญญา ลบรายการเดิมก่อน</p>'); return; }
    var name = $('nm').value.trim() || ('สัญญา ' + (saved.length + 1));
    saved.push({ name: name, type: current.type, P: current.P, rate: current.rate, n: current.n, pay: current.pay, totalInt: current.totalInt });
    $('nm').value = '';
    persist(); drawCompare();
  });

  $('cmp').addEventListener('click', function (e) {
    var d = e.target.getAttribute && e.target.getAttribute('data-del');
    if (d !== null && d !== undefined) { saved.splice(parseInt(d, 10), 1); persist(); drawCompare(); }
  });

  ['P', 'R', 'N', 'X'].forEach(function (id) { $(id).addEventListener('input', render); });
  Array.prototype.forEach.call(document.querySelectorAll('input[name=type]'), function (r) { r.addEventListener('change', render); });

  // Main(): จุดเริ่มต้นโปรแกรม เรียกฟังก์ชันอื่นทั้งหมดจากที่นี่
  function main() {
    load();
    render();
    drawCompare();
  }
  main();
})();
</script>
</body>
</html>
