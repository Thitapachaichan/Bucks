@page
@model BucksWeb.Pages.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bucks</title>
    <style>
        body { font-family: "Sarabun", "Noto Sans Thai", system-ui, sans-serif; margin: 0; background: #f2f4f1; color: #15292b; }
        .wrap { max-width: 900px; margin: 0 auto; padding: 24px 16px 60px; }
        h1 { margin: 0 0 4px; }
        form { background: #e6ebe6; padding: 18px; border-radius: 12px; margin-top: 16px; }
        label { display: block; font-weight: 600; margin: 10px 0 4px; }
        input[type=number] { width: 100%; padding: 8px; font-size: 1rem; border: 1px solid #aab8b0; border-radius: 6px; box-sizing: border-box; }
        .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .types label { display: inline-block; margin-right: 16px; font-weight: 400; }
        button { margin: 16px 8px 0 0; padding: 10px 18px; border: 0; border-radius: 6px; background: #0f5c4d; color: #fff; font-size: 1rem; cursor: pointer; }
        button.alt { background: #53686a; }
        .error { color: #b3402a; font-weight: 600; margin-top: 12px; }
        .big { font-size: 2.6rem; font-weight: 700; margin: 4px 0; }
        .facts { display: flex; flex-wrap: wrap; gap: 24px; margin: 12px 0; }
        .facts div span { display: block; font-size: .85rem; color: #53686a; }
        .tablebox { overflow-x: auto; max-height: 420px; overflow-y: auto; border: 1px solid #c4cec8; border-radius: 8px; margin-top: 12px; }
        table { border-collapse: collapse; width: 100%; min-width: 520px; }
        th, td { padding: 6px 10px; text-align: right; border-bottom: 1px solid #c4cec8; }
        th { background: #e6ebe6; position: sticky; top: 0; }
        th:first-child, td:first-child { text-align: left; }
    </style>
</head>
<body>
<div class="wrap">
    <h1>Bucks</h1>
    <p>ระบบคำนวณและวางแผนดอกเบี้ยเงินกู้ / ผ่อนชำระ</p>

    <form method="post">
        <div class="types">
            <label><input type="radio" name="LoanType" value="2" checked="@(Model.LoanType == 2)" /> ลดต้นลดดอก</label>
            <label><input type="radio" name="LoanType" value="1" checked="@(Model.LoanType == 1)" /> Flat</label>
        </div>

        <label for="Principal">เงินต้น (บาท)</label>
        <input type="number" step="any" id="Principal" name="Principal" value="@Model.Principal" />

        <div class="row">
            <div>
                <label for="AnnualRate">ดอกเบี้ยต่อปี (%)</label>
                <input type="number" step="any" id="AnnualRate" name="AnnualRate" value="@Model.AnnualRate" />
            </div>
            <div>
                <label for="Months">จำนวนงวด (เดือน)</label>
                <input type="number" id="Months" name="Months" value="@Model.Months" />
            </div>
        </div>

        <label for="ExtraPayment">จ่ายเพิ่มต่อเดือน (บาท, ใช้กับแบบลดต้นลดดอก)</label>
        <input type="number" step="any" id="ExtraPayment" name="ExtraPayment" value="@Model.ExtraPayment" />

        <button type="submit">คำนวณ</button>
        <button type="submit" class="alt" formaction="?handler=Download">ดาวน์โหลด CSV</button>
    </form>

    @if (Model.ErrorMessage != null)
    {
        <p class="error">@Model.ErrorMessage</p>
    }

    @if (Model.Result != null)
    {
        <h2>ผลการคำนวณ (@LoanCalculator.TypeName(Model.LoanType))</h2>
        <div>ค่างวดต่อเดือน</div>
        <div class="big">@Model.Result.MonthlyPayment.ToString("N2") บาท</div>

        <div class="facts">
            <div><span>ดอกเบี้ยรวม</span>@Model.Result.TotalInterest.ToString("N2")</div>
            <div><span>จ่ายทั้งหมด</span>@Model.Result.TotalPaid.ToString("N2")</div>
            @if (Model.LoanType == 1)
            {
                <div><span>ดอกเบี้ยที่แท้จริงต่อปี (ประมาณ)</span>@Model.RealRate.ToString("N2") %</div>
            }
        </div>

        @if (Model.Warning != null)
        {
            <p class="error">@Model.Warning</p>
        }

        @if (Model.HasExtra)
        {
            <p>ถ้าจ่ายเพิ่ม @Model.ExtraPayment.ToString("N2") บาท/เดือน จะปิดหนี้ใน <b>@Model.ExtraMonths งวด</b>
               (เดิม @Model.Months งวด) ประหยัดดอกเบี้ย <b>@Model.ExtraSaved.ToString("N2") บาท</b></p>
        }

        <h2>ตารางผ่อนชำระ</h2>
        <div class="tablebox">
            <table>
                <thead>
                    <tr><th>งวด</th><th>ค่างวด</th><th>ดอกเบี้ย</th><th>เงินต้น</th><th>คงเหลือ</th></tr>
                </thead>
                <tbody>
                @for (int i = 0; i < Model.Result.InterestArr.Length; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Model.Result.MonthlyPayment.ToString("N2")</td>
                        <td>@Model.Result.InterestArr[i].ToString("N2")</td>
                        <td>@Model.Result.PrincipalArr[i].ToString("N2")</td>
                        <td>@Model.Result.BalanceArr[i].ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Yearly != null)
    {
        <h2>สรุปรายปี</h2>
        <div class="tablebox">
            <table>
                <thead>
                    <tr><th>ปีที่</th><th>ค่างวดรวม</th><th>ดอกเบี้ย</th><th>เงินต้น</th><th>คงเหลือสิ้นปี</th></tr>
                </thead>
                <tbody>
                @for (int y = 0; y < Model.Yearly.GetLength(0); y++)
                {
                    <tr>
                        <td>@(y + 1)</td>
                        @for (int c = 0; c < 4; c++)
                        {
                            <td>@Model.Yearly[y, c].ToString("N2")</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <h2>ประวัติการคำนวณ (อ่านจากไฟล์ history.txt)</h2>
    @if (Model.History != null && Model.History.GetLength(0) > 0)
    {
        <div class="tablebox">
            <table>
                <thead>
                    <tr><th>เวลา</th><th>ประเภท</th><th>เงินต้น</th><th>ดอกเบี้ย %</th><th>งวด</th><th>ค่างวด</th><th>ดอกเบี้ยรวม</th></tr>
                </thead>
                <tbody>
                @for (int h = 0; h < Model.History.GetLength(0); h++)
                {
                    <tr>
                        @for (int c = 0; c < Model.History.GetLength(1); c++)
                        {
                            <td>@Model.History[h, c]</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>ยังไม่มีประวัติ</p>
    }
    <form method="post" style="margin-top:12px">
        <button type="submit" class="alt" formaction="?handler=ClearHistory">ล้างประวัติ</button>
    </form>
</div>
</body>
</html>
